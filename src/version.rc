#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION QBMF_VERSION_MAJOR, QBMF_VERSION_MINOR, QBMF_VERSION_PATCH, 0
PRODUCTVERSION QBMF_VERSION_MAJOR, QBMF_VERSION_MINOR, QBMF_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Quantum Break raw input mouse fix (ASI plugin)"
            VALUE "FileVersion", QBMF_VERSION_STR
            VALUE "LegalCopyright", "Copyright (c) 2026 slopkhayzo, MIT License"
            VALUE "OriginalFilename", "QBMouseFix.asi"
            VALUE "ProductName", "QBMouseFix"
            VALUE "ProductVersion", QBMF_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
